# Шаблон локального окружения. Значения replace-with-local-secret scripts/bootstrap.mjs заменяет случайными.
# Не коммитьте настоящий .env.
#
# Тестовые аккаунты сайта (создаются сидером только локально, в .env не хранятся):
#   администратор  admin@shift.local   пароль ShiftDemo2026!   (http://localhost:8088/admin/)
#   игрок          player@shift.local  пароль ShiftDemo2026!   (http://localhost:8088/auth)
# Grafana (профиль monitoring): логин admin, пароль — GRAFANA_PASSWORD ниже, http://localhost:3038/
# RabbitMQ: http://localhost:15678/, логин RABBITMQ_USER, пароль RABBITMQ_PASSWORD.
COMPOSE_PROJECT_NAME=shift
APP_ORIGIN=http://localhost:8088
# Режим запуска. dev (по умолчанию) — для разработки и автотестов: лимиты на вход и запросы подняты
# (1000/мин и 10000/мин), заселять по брони можно за 30 дней до начала. prod — строгие правила:
# 10 попыток входа и 120 запросов в минуту, заселение за 15 минут до начала.
# Любое значение можно переопределить отдельно: AUTH_RATE_LIMIT, API_RATE_LIMIT, CHECKIN_EARLY_MINUTES.
SHIFT_MODE=dev
SHIFT_HTTP_PORT=8088
POSTGRES_PASSWORD=replace-with-local-secret
IDENTITY_DB_PASSWORD=replace-with-local-secret
CLUB_DB_PASSWORD=replace-with-local-secret
BOOKING_DB_PASSWORD=replace-with-local-secret
REPORTING_DB_PASSWORD=replace-with-local-secret
RABBITMQ_USER=shift
RABBITMQ_PASSWORD=replace-with-local-secret
INTERNAL_TOKEN=replace-with-local-secret
CSRF_SECRET=replace-with-local-secret
GRAFANA_PASSWORD=replace-with-local-secret
